<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Mode Values -->
    <Color x:Key="BackgroundColor">#08162C</Color>
    <Color x:Key="SurfaceColor">#102543</Color>
    <Color x:Key="SurfaceSoftColor">#152D4D</Color>
    <Color x:Key="BorderColor">#244062</Color>
    
    <Color x:Key="TextPrimaryColor">#EDF4FF</Color>
    <Color x:Key="TextSecondaryColor">#9FB0C9</Color>
    
    <!-- Shared Brand Colors -->
    <Color x:Key="BrandCoralColor">#FF604B</Color>
    <Color x:Key="BrandCoralSoftColor">#3B2833</Color>
    <Color x:Key="SuccessColor">#16835B</Color>

    <!-- Semantic Brushes mapping for Dark Theme -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource SurfaceSoftColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    
    <SolidColorBrush x:Key="BrandCoralBrush" Color="{StaticResource BrandCoralColor}" />
    <SolidColorBrush x:Key="BrandCoralSoftBrush" Color="{StaticResource BrandCoralSoftColor}" />
    
    <SolidColorBrush x:Key="SuccessPrimaryBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SurfaceSoftColor}" />
    
    <SolidColorBrush x:Key="InfoPrimaryBrush" Color="#4C9AFF" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#0B213D" />
</ResourceDictionary>
