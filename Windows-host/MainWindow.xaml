<Window x:Class="WindowsHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EZ Across Control" Height="450" Width="600"
        Background="{DynamicResource BackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="./Fonts/#Inter">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Margin="0,0,0,20">
            <TextBlock Text="EZ Across Control" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrandCoralBrush}"/>
            <ComboBox x:Name="CmbTheme" HorizontalAlignment="Right" Width="120" SelectionChanged="CmbTheme_SelectionChanged">
                <ComboBoxItem Content="System" Tag="System"/>
                <ComboBoxItem Content="Light" Tag="Light"/>
                <ComboBoxItem Content="Dark" Tag="Dark"/>
            </ComboBox>
        </Grid>
        
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Network Settings" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Local IP: " FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Width="70"/>
                    <TextBlock x:Name="TxtLocalIP" Text="Unknown"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Port: " FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPort" Width="60" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Server Status" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Status: " FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Width="70"/>
                        <TextBlock x:Name="TxtServerStatus" Text="Stopped" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkEnableStreamingTest" Content="Enable Input Streaming Test (Warning: Captures everything)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStart" Content="Start" Width="80" Margin="0,0,10,0" Click="BtnStart_Click" Background="{DynamicResource BrandCoralBrush}" Foreground="{DynamicResource SurfaceBrush}" BorderThickness="0" Padding="5"/>
                    <Button x:Name="BtnStop" Content="Stop" Width="80" IsEnabled="False" Click="BtnStop_Click" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="5"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Android Client" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Status: " FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Width="70"/>
                    <TextBlock x:Name="TxtAndroidStatus" Text="Disconnected" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Device: " FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Width="70"/>
                    <TextBlock x:Name="TxtDeviceName" Text="-" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Android Screen Position" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Position:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Width="120" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbActiveEdge" Width="100" SelectionChanged="CmbActiveEdge_SelectionChanged">
                        <ComboBoxItem Content="Left" Tag="Left"/>
                        <ComboBoxItem Content="Right" Tag="Right"/>
                        <ComboBoxItem Content="Top" Tag="Top"/>
                        <ComboBoxItem Content="Bottom" Tag="Bottom"/>
                        <ComboBoxItem Content="Disabled" Tag="Disabled"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Edge sensitivity:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtEdgeThreshold" Width="60" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" TextChanged="TxtEdgeOptions_TextChanged"/>
                    <TextBlock Text=" px" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Activation delay:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtEdgeDelay" Width="60" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" TextChanged="TxtEdgeOptions_TextChanged"/>
                    <TextBlock Text=" ms" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status: " FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Width="120"/>
                    <TextBlock x:Name="TxtEdgeStatus" Text="Waiting" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Input Capture" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Status: " FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Width="70"/>
                        <TextBlock x:Name="TxtCaptureStatus" Text="Idle" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkShowInputDebug" Content="Show Input Debug" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStartUHID" Content="Start UHID Test" Width="100" Margin="0,0,10,0" Click="BtnStartUHID_Click" Background="{DynamicResource BrandCoralBrush}" Foreground="{DynamicResource SurfaceBrush}" BorderThickness="0" Padding="5"/>
                    <Button x:Name="BtnStopUHID" Content="Stop UHID Test" Width="100" Margin="0,0,20,0" IsEnabled="False" Click="BtnStopUHID_Click" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="5"/>
                    <Button x:Name="BtnStartCapture" Content="Start Capture" Width="90" Margin="0,0,10,0" Click="BtnStartCapture_Click" Background="{DynamicResource BrandCoralBrush}" Foreground="{DynamicResource SurfaceBrush}" BorderThickness="0" Padding="5"/>
                    <Button x:Name="BtnStopCapture" Content="Stop Capture" Width="90" IsEnabled="False" Click="BtnStopCapture_Click" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="5"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <TextBox x:Name="HiddenImeSink" Width="1" Height="1" Opacity="0.01" IsHitTestVisible="False" PreviewTextInput="HiddenImeSink_PreviewTextInput" TextChanged="HiddenImeSink_TextChanged" InputMethod.IsInputMethodEnabled="True" />
        
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="TxtLog" Grid.Column="0" Margin="0,0,5,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
            
            <TextBox x:Name="TxtInputDebug" Grid.Column="1" Margin="5,0,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
