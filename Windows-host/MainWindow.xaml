<Window x:Class="WindowsHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EZ Across Control" Height="750" Width="1020" MinHeight="620" MinWidth="780"
        Icon="/WindowsHost;component/Assets/EzAcrossControl.png"
        Background="{DynamicResource BackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="./Fonts/#Inter">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrandCoralBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="33"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,23,26,27" MaxWidth="1120">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/WindowsHost;component/Assets/EzAcrossControl.png" Width="42" Height="42" Stretch="Uniform" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="EZ" FontFamily="./Fonts/#Fraunces EZ" FontWeight="ExtraBold" FontSize="24"/>
                                <TextBlock Text=" Across Control" FontFamily="./Fonts/#Fraunces Across" FontWeight="Medium" FontStyle="Italic" FontSize="23"/>
                            </StackPanel>
                            <TextBlock Text="Windows host" Style="{StaticResource LabelStyle}" Margin="1,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="THEME" Style="{StaticResource LabelStyle}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbTheme" Width="122" SelectionChanged="CmbTheme_SelectionChanged">
                            <ComboBoxItem Content="System" Tag="System"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="23">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CONNECTION STATUS" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtServerStatus" Text="Stopped" FontSize="25" FontWeight="Bold"/>
                            <TextBlock Text="Local server status for your Android device." Style="{StaticResource LabelStyle}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnStart" Content="Start server" Click="BtnStart_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button x:Name="BtnStop" Content="Stop" IsEnabled="False" Click="BtnStop_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Network" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,18"/>
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Local IP" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="TxtLocalIP" Grid.Column="1" Text="Unknown" Style="{StaticResource ValueStyle}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Port" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtPort" Grid.Column="1" Width="88" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Screen edge" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Android position" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="CmbActiveEdge" Grid.Column="1" Width="113" HorizontalAlignment="Left" SelectionChanged="CmbActiveEdge_SelectionChanged">
                                    <ComboBoxItem Content="Left" Tag="Left"/><ComboBoxItem Content="Right" Tag="Right"/>
                                    <ComboBoxItem Content="Top" Tag="Top"/><ComboBoxItem Content="Bottom" Tag="Bottom"/>
                                    <ComboBoxItem Content="Disabled" Tag="Disabled"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Sensitivity" Style="{StaticResource LabelStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="TxtEdgeThreshold" Width="75" TextChanged="TxtEdgeOptions_TextChanged"/><TextBlock Text="px" Style="{StaticResource LabelStyle}" Margin="7,0,0,0"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Activation delay" Style="{StaticResource LabelStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="TxtEdgeDelay" Width="75" TextChanged="TxtEdgeOptions_TextChanged"/><TextBlock Text="ms" Style="{StaticResource LabelStyle}" Margin="7,0,0,0"/></StackPanel>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Edge status" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="TxtEdgeStatus" Grid.Column="1" Text="Waiting" Style="{StaticResource ValueStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Android device" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,17"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Device" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/><TextBlock x:Name="TxtDeviceName" Text="-" Style="{StaticResource ValueStyle}"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Connection mode" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbConnectionMode" Width="115" HorizontalAlignment="Left" SelectionChanged="CmbConnectionMode_SelectionChanged">
                                    <ComboBoxItem Content="Auto" Tag="Auto"/><ComboBoxItem Content="USB" Tag="Usb"/><ComboBoxItem Content="Wi-Fi" Tag="Network"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Transport / control" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="TxtTransport" Text="-" Style="{StaticResource ValueStyle}"/><TextBlock Text=" / " Style="{StaticResource ValueStyle}"/><TextBlock x:Name="TxtControlState" Text="Windows" Style="{StaticResource ValueStyle}"/></StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Input engine" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Engine: " Style="{StaticResource LabelStyle}"/><TextBlock x:Name="TxtEngineState" Text="Offline" Style="{StaticResource ValueStyle}"/></StackPanel>
                            <TextBlock x:Name="TxtEngineStatus" Text="Offline" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnStartEngine" Content="Start engine" Click="BtnStartEngine_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button x:Name="BtnCaptureAndroid" Content="Capture Android" IsEnabled="False" Click="BtnCaptureAndroid_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button x:Name="BtnReturnWindows" Content="Return Windows" IsEnabled="False" Click="BtnReturnWindows_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander Header="Diagnostics and activity log" Margin="1,16,1,0" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Grid Margin="0,12,0,0">
                        <TextBox x:Name="TxtLog" IsReadOnly="True" Height="170" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/>
                        <TextBox x:Name="TxtInputDebug" Visibility="Collapsed" IsReadOnly="True"/>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <TextBox x:Name="HiddenImeSink" Width="1" Height="1" Opacity="0.01" IsHitTestVisible="False"
                 PreviewTextInput="HiddenImeSink_PreviewTextInput" TextChanged="HiddenImeSink_TextChanged"
                 InputMethod.IsInputMethodEnabled="True"/>
    </Grid>
</Window>
