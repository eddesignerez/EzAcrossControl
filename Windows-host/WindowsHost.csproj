<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>EzAcrossControl</AssemblyName>
    <Product>EZ Across Control</Product>
    <AssemblyTitle>EZ Across Control</AssemblyTitle>
    <Version>1.1.22</Version>
    <AssemblyVersion>1.1.22.0</AssemblyVersion>
    <FileVersion>1.1.22.0</FileVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\EzAcrossControl152D4D.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Localization\catalog.json" LogicalName="WindowsHost.Localization.catalog.json" />
    <Resource Include="Fonts\Inter.ttf" />
    <Resource Include="Fonts\FrauncesEZ-ExtraBold.ttf" />
    <Resource Include="Fonts\FrauncesAcross-MediumItalic.ttf" />
    <Resource Include="Assets\EzAcrossControl.png" />
    <Resource Include="Assets\EzAcrossControlOFF.png" />
    <Content Include="Assets\EzAcrossControl152D4D.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\EzAcrossControlOFF.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
