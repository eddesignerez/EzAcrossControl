+
 void
 sc_mouse_capture_init(struct sc_mouse_capture *mc, SDL_Window *window,
                       uint8_t shortcut_mods) {
@@ -21,7 +29,16 @@ sc_mouse_capture_handle_event(struct sc_mouse_capture *mc,
                               const SDL_Event *event) {
     switch (event->type) {
         case SDL_EVENT_WINDOW_FOCUS_LOST:
+#ifdef _WIN32
+            // A queued focus event from before CAPTURE_ON must not release a
+            // currently focused window. A real focus loss ends this handoff.
+            if (SDL_GetKeyboardFocus() == mc->window) return true;
+            bool was_active = ez_capture_active;
+#endif
             sc_mouse_capture_set_active(mc, false);
+#ifdef _WIN32
+            if (was_active) ezacross_capture_lost();
+#endif
             return true;
         case SDL_EVENT_KEY_DOWN: {
             SDL_Keycode key = event->key.key;
@@ -46,7 +63,14 @@ sc_mouse_capture_handle_event(struct sc_mouse_capture *mc,
                 if (key == cap) {
                     // A mouse capture key has been pressed then released:
                     // toggle the capture mouse mode
+#ifdef _WIN32
+                    if (ez_capture_active) {
+                        sc_mouse_capture_toggle(mc);
+                        if (!sc_mouse_capture_is_active(mc)) ezacross_capture_lost();
+                    }
+#else
                     sc_mouse_capture_toggle(mc);
+#endif
                 }
                 // Mouse capture keys are never forwarded to the device
                 return true;
@@ -64,6 +88,11 @@ sc_mouse_capture_handle_event(struct sc_mouse_capture *mc,
             break;
         case SDL_EVENT_MOUSE_BUTTON_UP:
             if (!sc_mouse_capture_is_active(mc)) {
+#ifdef _WIN32
+                if (!ez_capture_active) {
+                    return true;
+                }
+#endif
                 sc_mouse_capture_set_active(mc, true);
                 return true;
             }
@@ -81,11 +110,28 @@ sc_mouse_capture_handle_event(struct sc_mouse_capture *mc,

 void
 sc_mouse_capture_set_active(struct sc_mouse_capture *mc, bool capture) {
+#ifdef _WIN32
+    // CAPTURE_OFF may be followed by FOCUS_LOST when the host hides the input
+    // window. Reapplying the same SDL mode can warp the Windows cursor.
+    if (SDL_GetWindowRelativeMouseMode(mc->window) == capture) {
+        if (!ezacross_capture_mouse(mc->window, capture) && capture) {
+            SDL_SetWindowRelativeMouseMode(mc->window, false);
+        }
+        return;
+    }
+    if (!capture) ezacross_capture_mouse(mc->window, false);
+#endif
     bool ok = SDL_SetWindowRelativeMouseMode(mc->window, capture);
     if (!ok) {
         LOGE("Could not set relative mouse mode to %s: %s",
              capture ? "true" : "false", SDL_GetError());
     }
+#ifdef _WIN32
+    if (capture && ok && !ezacross_capture_mouse(mc->window, true)) {
+        LOGE("Could not capture native Windows mouse buttons");
+        SDL_SetWindowRelativeMouseMode(mc->window, false);
+    }
+#endif
 }

