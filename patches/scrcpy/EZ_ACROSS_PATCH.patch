diff --git a/app/src/main.c b/app/src/main.c
index 47117423..e44b8cba 100644
--- a/app/src/main.c
+++ b/app/src/main.c
@@ -22,6 +22,165 @@
 #ifdef _WIN32
 #include <windows.h>
 #include "util/str.h"
+#include "screen.h"
+
+struct sc_screen *ez_screen = NULL;
+bool ez_capture_active = false;
+HANDLE ez_screen_ready = NULL;
+static HANDLE ez_ipc_pipe = INVALID_HANDLE_VALUE;
+static CRITICAL_SECTION ez_ipc_write_lock;
+bool ezacross_capture_mouse(SDL_Window *window, bool active);
+void ezacross_capture_lost(void);
+
+static void ezacross_ipc_send(const char *message) {
+    DWORD written;
+    EnterCriticalSection(&ez_ipc_write_lock);
+    if (ez_ipc_pipe != INVALID_HANDLE_VALUE) {
+        WriteFile(ez_ipc_pipe, message, (DWORD) strlen(message), &written, NULL);
+    }
+    LeaveCriticalSection(&ez_ipc_write_lock);
+}
+
+bool ezacross_capture_mouse(SDL_Window *window, bool active) {
+    HWND hwnd = SDL_GetPointerProperty(SDL_GetWindowProperties(window),
+                                      SDL_PROP_WINDOW_WIN32_HWND_POINTER, NULL);
+    if (!hwnd) return false;
+    if (!active) {
+        if (GetCapture() == hwnd) ReleaseCapture();
+        return true;
+    }
+    // SDL disables its automatic Win32 button capture in relative mode.
+    // Route legacy button messages to this same 1px input window, so a click
+    // cannot activate the Windows application behind the handoff edge.
+    if (GetForegroundWindow() != hwnd) return false;
+    SetCapture(hwnd);
+    return GetCapture() == hwnd;
+}
+
+void ezacross_capture_lost(void) {
+    ez_capture_active = false;
+    fprintf(stderr, "[EZACROSS CAPTURE] Native capture released outside host request\n");
+    ezacross_ipc_send("CAPTURE_LOST\n");
+}
+
+struct ez_capture_request {
+    bool active;
+    bool applied;
+};
+
+static void ezacross_ipc_set_capture(void *userdata) {
+    struct ez_capture_request *request = userdata;
+    ez_capture_active = false;
+    if (ez_screen) {
+        sc_mouse_capture_set_active(&ez_screen->mc, request->active);
+        bool actual = sc_mouse_capture_is_active(&ez_screen->mc);
+        request->applied = actual == request->active;
+        ez_capture_active = actual;
+    }
+    // Publish on the SDL thread, before any queued focus-loss notification.
+    ezacross_ipc_send(request->applied
+        ? (request->active ? "CAPTURED\n" : "RELEASED\n")
+        : (request->active ? "ERROR CAPTURE_FAILED\n" : "ERROR RELEASE_FAILED\n"));
+}
+
+static int ezacross_ipc_thread(void *data) {
+    (void)data;
+    HANDLE hPipe;
+    DWORD dwRead, dwWritten;
+
+    fprintf(stderr, "[EZACROSS IPC] thread started\\n");
+
+    while (1) {
+        hPipe = CreateFileA(
+            "\\\\.\\pipe\\EZAcrossScrcpy",
+            GENERIC_READ | GENERIC_WRITE,
+            0,
+            NULL,
+            OPEN_EXISTING,
+            0,
+            NULL);
+
+        if (hPipe != INVALID_HANDLE_VALUE) {
+            fprintf(stderr, "[EZACROSS IPC] connected\\n");
+            break;
+        }
+
+        DWORD err = GetLastError();
+        fprintf(stderr, "[EZACROSS IPC] CreateFile failed error=%lu\\n", err);
+
+        if (err != ERROR_PIPE_BUSY) {
+            SDL_Delay(100);
+            continue;
+        }
+
+        if (!WaitNamedPipeA("\\\\.\\pipe\\EZAcrossScrcpy", 5000)) {
+            fprintf(stderr, "[EZACROSS IPC] connect timeout\\n");
+            continue;
+        }
+    }
+
+    EnterCriticalSection(&ez_ipc_write_lock);
+    ez_ipc_pipe = hPipe;
+    LeaveCriticalSection(&ez_ipc_write_lock);
+
+    // READY means the native input window exists, not merely that the pipe opened.
+    if (WaitForSingleObject(ez_screen_ready, 10000) != WAIT_OBJECT_0) {
+        EnterCriticalSection(&ez_ipc_write_lock);
+        ez_ipc_pipe = INVALID_HANDLE_VALUE;
+        LeaveCriticalSection(&ez_ipc_write_lock);
+        CloseHandle(hPipe);
+        return 1;
+    }
+    const char *ready_msg = "READY\n";
+    fprintf(stderr, "[EZACROSS IPC] sending READY\\n");
+    if (!WriteFile(hPipe, ready_msg, (DWORD)strlen(ready_msg), &dwWritten, NULL)) {
+        fprintf(stderr, "[EZACROSS IPC] READY write failed, error=%lu\\n", GetLastError());
+    } else {
+        fprintf(stderr, "[EZACROSS IPC] READY write bytes=%lu\\n", dwWritten);
+    }
+
+    while (1) {
+        char line[128] = {0};
+        int idx = 0;
+        bool eof = false;
+        while (1) {
+            char ch;
+            if (!ReadFile(hPipe, &ch, 1, &dwRead, NULL) || dwRead == 0) {
+                eof = true;
+                break;
+            }
+            if (ch == '\n') {
+                break;
+            }
+            if (ch != '\r' && idx < 127) {
+                line[idx++] = ch;
+            }
+        }
+
+        if (eof) break;
+
+        if (strcmp(line, "CAPTURE_ON") == 0) {
+            struct ez_capture_request request = { .active = true };
+            if (!sc_run_on_main_thread(ezacross_ipc_set_capture, &request, true))
+                ezacross_ipc_send("ERROR CAPTURE_FAILED\n");
+        } else if (strcmp(line, "CAPTURE_OFF") == 0) {
+            struct ez_capture_request request = { .active = false };
+            if (!sc_run_on_main_thread(ezacross_ipc_set_capture, &request, true))
+                ezacross_ipc_send("ERROR RELEASE_FAILED\n");
+        } else if (strcmp(line, "SHUTDOWN") == 0) {
+            SDL_Event event;
+            event.type = SDL_EVENT_QUIT;
+            SDL_PushEvent(&event);
+            break;
+        }
+    }
+
+    EnterCriticalSection(&ez_ipc_write_lock);
+    ez_ipc_pipe = INVALID_HANDLE_VALUE;
+    CloseHandle(hPipe);
+    LeaveCriticalSection(&ez_ipc_write_lock);
+    return 0;
+}
 #endif

 static int
@@ -33,6 +192,17 @@ main_scrcpy(int argc, char *argv[]) {
     setbuf(stderr, NULL);
 #endif

+// --- EZ ACROSS PATCH: Named Pipe IPC ---
+#ifdef _WIN32
+    fprintf(stderr, "[EZACROSS IPC] thread created\\n");
+    InitializeCriticalSection(&ez_ipc_write_lock);
+    ez_screen_ready = CreateEventA(NULL, TRUE, FALSE, NULL);
+    sc_thread ipc_thread;
+    sc_thread_create(&ipc_thread, ezacross_ipc_thread, "EZAcrossIPC", NULL);
+#endif
+// ---------------------------------------
+
+    fprintf(stderr, "[EZACROSS] IPC patch active\\n");
     printf("scrcpy " SCRCPY_VERSION
            " <https://github.com/Genymobile/scrcpy>\n");

