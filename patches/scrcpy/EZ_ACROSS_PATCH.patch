index 47117423..fedf283d 100644
--- a/app/src/main.c
+++ b/app/src/main.c
@@ -22,6 +22,108 @@
 #ifdef _WIN32
 #include <windows.h>
 #include "util/str.h"
+#include "screen.h"
+
+struct sc_screen *ez_screen = NULL;
+bool ez_capture_active = false;
+HANDLE ez_screen_ready = NULL;
+
+static void ezacross_ipc_set_capture(void *userdata) {
+    bool active = (bool)(uintptr_t)userdata;
+    ez_capture_active = active;
+    if (ez_screen) {
+        sc_mouse_capture_set_active(&ez_screen->mc, active);
+    }
+}
+
+static int ezacross_ipc_thread(void *data) {
+    (void)data;
+    HANDLE hPipe;
+    DWORD dwRead, dwWritten;
+
+    fprintf(stderr, "[EZACROSS IPC] thread started\\n");
+
+    while (1) {
+        hPipe = CreateFileA(
+            "\\\\.\\pipe\\EZAcrossScrcpy",
+            GENERIC_READ | GENERIC_WRITE,
+            0,
+            NULL,
+            OPEN_EXISTING,
+            0,
+            NULL);
+
+        if (hPipe != INVALID_HANDLE_VALUE) {
+            fprintf(stderr, "[EZACROSS IPC] connected\\n");
+            break;
+        }
+
+        DWORD err = GetLastError();
+        fprintf(stderr, "[EZACROSS IPC] CreateFile failed error=%lu\\n", err);
+
+        if (err != ERROR_PIPE_BUSY) {
+            SDL_Delay(100);
+            continue;
+        }
+
+        if (!WaitNamedPipeA("\\\\.\\pipe\\EZAcrossScrcpy", 5000)) {
+            fprintf(stderr, "[EZACROSS IPC] connect timeout\\n");
+            continue;
+        }
+    }
+
+    // READY means the native input window exists, not merely that the pipe opened.
+    if (WaitForSingleObject(ez_screen_ready, 10000) != WAIT_OBJECT_0) {
+        CloseHandle(hPipe);
+        return 1;
+    }
+    const char *ready_msg = "READY\n";
+    fprintf(stderr, "[EZACROSS IPC] sending READY\\n");
+    if (!WriteFile(hPipe, ready_msg, (DWORD)strlen(ready_msg), &dwWritten, NULL)) {
+        fprintf(stderr, "[EZACROSS IPC] READY write failed, error=%lu\\n", GetLastError());
+    } else {
+        fprintf(stderr, "[EZACROSS IPC] READY write bytes=%lu\\n", dwWritten);
+    }
+
+    while (1) {
+        char line[128] = {0};
+        int idx = 0;
+        bool eof = false;
+        while (1) {
+            char ch;
+            if (!ReadFile(hPipe, &ch, 1, &dwRead, NULL) || dwRead == 0) {
+                eof = true;
+                break;
+            }
+            if (ch == '\n') {
+                break;
+            }
+            if (ch != '\r' && idx < 127) {
+                line[idx++] = ch;
+            }
+        }
+
+        if (eof) break;
+
+        if (strcmp(line, "CAPTURE_ON") == 0) {
+            bool applied = sc_run_on_main_thread(ezacross_ipc_set_capture, (void*)(uintptr_t)1, true);
+            const char *msg = applied ? "CAPTURED\n" : "ERROR CAPTURE_FAILED\n";
+            WriteFile(hPipe, msg, strlen(msg), &dwWritten, NULL);
+        } else if (strcmp(line, "CAPTURE_OFF") == 0) {
+            bool applied = sc_run_on_main_thread(ezacross_ipc_set_capture, (void*)(uintptr_t)0, true);
+            const char *msg = applied ? "RELEASED\n" : "ERROR RELEASE_FAILED\n";
+            WriteFile(hPipe, msg, strlen(msg), &dwWritten, NULL);
+        } else if (strcmp(line, "SHUTDOWN") == 0) {
+            SDL_Event event;
+            event.type = SDL_EVENT_QUIT;
+            SDL_PushEvent(&event);
+            break;
+        }
+    }
+
+    CloseHandle(hPipe);
+    return 0;
+}
 #endif
 
 static int
